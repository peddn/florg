# Kopiere diese Datei nach backend/.env und passe sie an.
# Alle Werte sind optional. Ohne .env gelten die hier gezeigten Vorgaben.

# Datenbank. "mode=rwc" legt die Datei an, falls sie fehlt.
FLORG_DATABASE_URL=sqlite://florg.db?mode=rwc

# Adresse, auf der das Backend lauscht.
FLORG_BIND=127.0.0.1:3000

# Verzeichnis mit dem gebauten Frontend. Existiert es, liefert das Backend es aus.
FLORG_FRONTEND_DIR=../frontend/dist

# Öffentliche Adresse der Anwendung. Aus ihr entstehen die Anmeldelinks.
# Im Betrieb die HTTPS-Adresse, z. B. https://florg.example.org
FLORG_PUBLIC_URL=http://localhost:5173

# Mailversand. Setze alle vier Werte oder keinen.
# Ohne diese Werte steht der Anmeldelink im Server-Protokoll, statt per Mail zu kommen.
# Die Verbindung ist immer verschlüsselt: Port 465 mit TLS, jeder andere Port mit STARTTLS.
#FLORG_SMTP_HOST=mail.example.org
#FLORG_SMTP_USER=florg@example.org
#FLORG_SMTP_PASSWORD=
#FLORG_MAIL_FROM=florg <florg@example.org>
# Optional, Vorgabe 587.
#FLORG_SMTP_PORT=587
