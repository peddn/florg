# Kopiere diese Datei nach backend/.env und passe sie an.
# Alle Werte sind optional. Ohne .env gelten die hier gezeigten Vorgaben.

# Datenbank. "mode=rwc" legt die Datei an, falls sie fehlt.
FLORG_DATABASE_URL=sqlite://florg.db?mode=rwc

# Adresse, auf der das Backend lauscht.
FLORG_BIND=127.0.0.1:3000

# Verzeichnis mit dem gebauten Frontend. Existiert es, liefert das Backend es aus.
FLORG_FRONTEND_DIR=../frontend/dist
